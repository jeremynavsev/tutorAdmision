# URL del backend de MAEstro (FastAPI). Copiá este archivo como .env.local.
NEXT_PUBLIC_API_URL=http://localhost:8100

# Qué tutor usa la página: "remoto" (el backend con IA real, por defecto) o "simulado"
# (respuestas de mentiras, para mostrar la interfaz sin backend ni cuota).
NEXT_PUBLIC_TUTOR=remoto
