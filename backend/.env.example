# Copiá este archivo como .env y completá los valores.
# Nunca subás el .env al repositorio.

# --- Proveedores de IA (en orden de la cadena: Gemini → Groq → Mistral) ---
# Llave de Google AI Studio para Gemini (proveedor principal).
GEMINI_API_KEY=
# Llave de Groq (primer respaldo).
GROQ_API_KEY=
# Llave de Mistral (segundo respaldo).
MISTRAL_API_KEY=

# Modelo de cada proveedor. Si se dejan vacíos, se usan estos valores por defecto.
# Si un proveedor retira un modelo, se cambia aquí sin tocar el código.
GEMINI_MODELO=gemini-3.8-flash
GROQ_MODELO=openai/gpt-oss-120b
MISTRAL_MODELO=mistral-small-latest
# Segundos máximos de espera por proveedor antes de pasar al siguiente.
TIEMPO_MAXIMO_IA=30

# --- Base de datos ---
# En local se usa SQLite. En producción, la cadena de conexión de Neon (PostgreSQL),
# por ejemplo: postgresql+psycopg://usuario:clave@host/maestro?sslmode=require
DATABASE_URL=sqlite:///./maestro.db

# --- Límites de uso ---
# Máximo de mensajes que un estudiante puede enviar en una sesión.
LIMITE_MENSAJES_SESION=40
# Máximo de mensajes por día desde un mismo origen.
LIMITE_MENSAJES_DIA=150

# --- Frontend ---
# Orígenes permitidos para CORS, separados por coma.
ORIGENES_PERMITIDOS=http://localhost:3100
