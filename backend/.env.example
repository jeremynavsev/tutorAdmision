# Copiá este archivo como .env y completá los valores.
# Nunca subás el .env al repositorio.

# --- Proveedores de IA ---
# Solo se usan los que tienen llave. Basta con una para que el tutor funcione.
# Llave de Groq: rápido y con buen límite gratuito, pero no lee fotos.
GROQ_API_KEY=
# Llave de Google AI Studio para Gemini: lee fotos, pero el plan gratuito permite muy
# pocos pedidos por día.
GEMINI_API_KEY=

# Orden en que se prueban. Si uno falla, se pasa al siguiente. Cuando el mensaje trae una
# foto, se saltan los que no leen imágenes (Groq).
ORDEN_PROVEEDORES=groq,gemini

# Modelo de cada proveedor. Si se dejan vacíos, se usan estos valores por defecto.
# Si un proveedor retira un modelo, se cambia aquí sin tocar el código.
GEMINI_MODELO=gemini-3.8-flash
GROQ_MODELO=openai/gpt-oss-120b
# Otros modelos de Gemini que se prueban si el principal falla o agota su cuota. El plan
# gratuito da pocos pedidos por día POR MODELO, así que cada respaldo suma pedidos (sobre
# todo para las fotos). Separados por coma; "ninguno" para no usar respaldos.
GEMINI_MODELOS_RESPALDO=gemini-3.5-flash,gemini-3.1-flash-lite
# Segundos máximos de espera por proveedor antes de pasar al siguiente.
TIEMPO_MAXIMO_IA=30
# Cuánto "piensa" Gemini antes de responder: low (rápido, recomendado), medium, high,
# o normal para no tocarlo. Con más razonamiento cada respuesta tarda varios segundos más.
GEMINI_RAZONAMIENTO=low

# --- Base de datos ---
# En local se usa SQLite. En producción, la cadena de conexión de Neon (PostgreSQL),
# por ejemplo: postgresql+psycopg://usuario:clave@host/maestro?sslmode=require
DATABASE_URL=sqlite:///./maestro.db

# --- Límites de uso ---
# Mensajes por estudiante (sesión) por día. El día se cuenta en hora de Costa Rica.
LIMITE_MENSAJES_SESION=40
# Mensajes por conexión por día. Alto a propósito: en un colegio todo un laboratorio
# comparte la misma conexión. Solo evita que alguien se salte el límite de su sesión.
LIMITE_MENSAJES_CONEXION=1000
# Clave para calcular la huella de cada conexión sin guardar su IP. Poné una frase
# larga al azar y no la compartás. Si queda vacía, se inventa una cada vez que arranca
# el servidor (y los contadores por conexión vuelven a cero al reiniciar).
SECRETO_HUELLAS=
# En producción, detrás de un proxy, la IP real viene en X-Forwarded-For: poné "sí".
CONFIAR_EN_PROXY=no

# --- Banco de ejercicios ---
# Archivo con los ejercicios (ruta desde backend/). El banco real va en ejercicios/privado/,
# que git ignora: así los ejercicios no se publican en el repositorio. Si se deja vacío,
# se usa el de ejemplo (ejercicios/banco.json, con dos ejercicios inventados).
BANCO_EJERCICIOS=ejercicios/privado/banco.json

# --- Frontend ---
# Orígenes permitidos para CORS, separados por coma.
ORIGENES_PERMITIDOS=http://localhost:3100
